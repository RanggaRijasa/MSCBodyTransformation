{
  "name": "msc-body-transformation-web",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "expo start --web",
    "build": "node scripts/build-production.mjs",
    "build:preview": "expo export --platform web --clear && node scripts/prepare-production-output.mjs",
    "export": "npm run build",
    "serve": "node scripts/serve-production.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration:local": "sh scripts/run-local-supabase-integration.sh",
    "test:functions:local": "node scripts/verify-local-edge-functions.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "sh scripts/generate-pwa-icons.sh",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:performance": "node scripts/verify-performance-budget.mjs",
    "verify:production-env": "node scripts/verify-production-environment.mjs",
    "verify:pwa": "node scripts/verify-pwa-assets.mjs",
    "worker:types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types worker-configuration.d.ts --strict-vars=false",
    "worker:types:check": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types worker-configuration.d.ts --strict-vars=false --check",
    "worker:dry-run": "npm run build && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --env preview --dry-run --outdir .wrangler/dry-run",
    "worker:production:dry-run": "npm run build && npm run verify:production-env && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --env= --dry-run --outdir .wrangler/production-dry-run",
    "worker:candidate:dry-run": "npm run build && npm run verify:production-env && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --env candidate --dry-run --outdir .wrangler/candidate-dry-run",
    "deploy:candidate": "npm run build && npm run verify:production-env && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --env candidate",
    "deploy:preview": "npm run build:preview && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --env preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.12",
    "expo-camera": "57.0.3",
    "expo-constants": "57.0.10",
    "expo-linking": "57.0.5",
    "expo-router": "57.0.12",
    "expo-status-bar": "57.0.1",
    "phosphor-react-native": "3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.85.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react-native": "14.0.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "eslint-config-expo": "57.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
