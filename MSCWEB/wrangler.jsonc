{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "msc-body-transformation-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "msc-body-transformation.com", "custom_domain": true },
    { "pattern": "www.msc-body-transformation.com", "custom_domain": true }
  ],
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "production",
    "SUPABASE_ORIGIN": "https://uoymesmgsitdoxouvgca.supabase.co"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "env": {
    "candidate": {
      "name": "msc-body-transformation-web-candidate",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": true
      },
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "candidate",
        "SUPABASE_ORIGIN": "https://uoymesmgsitdoxouvgca.supabase.co"
      }
    },
    "preview": {
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": true
      },
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "preview",
        "SUPABASE_ORIGIN": "https://uoymesmgsitdoxouvgca.supabase.co"
      }
    }
  }
}
