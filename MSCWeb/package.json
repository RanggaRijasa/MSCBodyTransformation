{
  "name": "msc-body-transformation-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA Bahasa Indonesia untuk program MSC Body Transformation.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --hostname 127.0.0.1",
    "dev:gallery": "vite --config development/vite.config.ts",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-architecture.mjs && node scripts/check-file-size.mjs && node scripts/check-public-secrets.mjs && node scripts/check-localization.mjs && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:phase03:local": "bash scripts/test-phase03-local.sh",
    "test:phase04:local": "bash scripts/test-phase04-local.sh",
    "test:phase05:local": "bash scripts/test-phase05-local.sh",
    "test:phase06:local": "bash scripts/test-phase06-local.sh",
    "test:phase06:fresh-local": "bash scripts/test-phase06-fresh-local.sh",
    "test:phase07:local": "bash scripts/test-phase07-local.sh",
    "test:phase08:local": "bash scripts/test-phase08-local.sh",
    "test:phase09:local": "bash scripts/test-phase09-local.sh",
    "test:phase10:local": "bash scripts/test-phase10-local.sh",
    "test:phase11:local": "bash scripts/test-phase11-local.sh",
    "payments:recurring:local": "node scripts/run-phase06-recurring-operations.mjs",
    "test:gallery": "playwright test --config=playwright.gallery.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:localization": "node scripts/check-localization.mjs",
    "check:phase04:bundle": "node scripts/check-phase04-bundle.mjs",
    "check:phase06:contract": "node scripts/check-phase06-contract.mjs",
    "check:phase08:privacy": "node scripts/check-phase08-privacy.mjs",
    "check:phase10:privacy": "node scripts/check-phase10-privacy.mjs",
    "check:phase11:performance": "node scripts/check-phase11-performance.mjs",
    "check:phase11:security": "node scripts/check-phase11-security.mjs",
    "generate:phase11:sbom": "node scripts/generate-phase11-sbom.mjs",
    "check:secrets": "node scripts/check-public-secrets.mjs",
    "verify": "node scripts/check-architecture.mjs && node scripts/check-file-size.mjs && node scripts/check-public-secrets.mjs && node scripts/check-localization.mjs && node scripts/check-phase06-contract.mjs && node scripts/check-phase08-privacy.mjs && node scripts/check-phase10-privacy.mjs && node scripts/check-phase11-security.mjs && eslint . && tsc --noEmit && vitest run && next build && node scripts/check-phase04-bundle.mjs && node scripts/check-phase11-performance.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "next": "16.3.0",
    "qr-scanner": "1.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "uqr": "0.1.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
